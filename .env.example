# Set variables in your shell before starting the server.
# This reference file is not loaded automatically.
# Shared LLM settings for intent understanding and RAG.
# Use a Chat Completions-compatible service with Bearer authentication and
# response_format={"type":"json_object"} support. Set all three together.
# LLM_BASE_URL is the API prefix, including /v1 if your provider requires it;
# the client appends /chat/completions.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional intent-stage overrides using the same API key:
# FLP_INTENT_LLM_MODEL=
# FLP_INTENT_LLM_BASE_URL=
# Legacy DeepSeek settings, used when the shared LLM settings are unset:
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# DEEPSEEK_BASE_URL=
# Local embedding model and vector index:
# BGE_M3_MODEL_PATH=
# BGE_M3_MODEL_NAME=BAAI/bge-m3
# ENGINEERING_RAG_INDEX_DIR=
