                  "string",
                  "null"
                ]
              },
              "library_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model_asset_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_node_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pose": {
                "$ref": "../common/common_engineering.schema.json#/$defs/Pose"
              },
              "geometry": {
                "$ref": "../common/common_engineering.schema.json#/$defs/Geometry"
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "instance_id",
              "library_id",
              "model_asset_id",
              "source_node_ref",
              "pose",
              "geometry",
              "confidence"
            ]
          }
        }
