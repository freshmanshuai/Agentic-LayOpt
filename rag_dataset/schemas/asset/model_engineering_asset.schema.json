              "zone_type": {
                "type": "string"
              },
              "pose": {
                "$ref": "../common/common_engineering.schema.json#/$defs/Pose"
              },
              "dimensions_m": {
                "$ref": "../common/common_engineering.schema.json#/$defs/DimensionsM"
              },
              "allowed_categories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source_node_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
