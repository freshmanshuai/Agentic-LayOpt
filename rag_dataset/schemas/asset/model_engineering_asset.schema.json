              "feature_type": {
                "type": "string",
                "enum": [
                  "entrance",
                  "exit",
                  "obstacle",
                  "forbidden_zone",
                  "corridor",
                  "wall",
                  "column",
                  "loading_area",
                  "unloading_area",
                  "utility_area",
                  "unknown",
                  "other"
                ]
              },
              "pose": {
                "$ref": "../common/common_engineering.schema.json#/$defs/Pose"
              },
              "dimensions_m": {
                "$ref": "../common/common_engineering.schema.json#/$defs/DimensionsM"
              },
              "source_node_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "site_feature_id",
              "feature_type",
              "pose",
              "dimensions_m",
              "source_node_ref",
              "confidence"
            ]
          }
        },
        "extracted_zones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "zone_id": {
                "type": "string"
