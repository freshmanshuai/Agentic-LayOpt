    "asset_name",
    "asset_description",
    "library_id",
    "site_id",
    "category",
    "equipment_type",
    "aliases",
    "model_files",
    "derived_files",
    "extraction",
    "coordinate_frames",
    "geometry",
    "planning_fields",
    "site_asset_fields",
    "manual_overrides",
    "provenance",
    "metadata"
  ],
  "additionalProperties": false
}
