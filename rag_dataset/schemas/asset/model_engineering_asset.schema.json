{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset/model_engineering_asset.schema.json",
  "title": "Model Engineering Asset Schema",
  "description": "Stores model files and engineering fields needed for layout planning. It supports equipment assets, site assets, production-line assets, and composite-scene assets.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "model_asset_id": {
      "type": "string"
    },
    "asset_scope": {
      "type": "string",
      "enum": [
        "equipment",
        "site",
        "production_line",
        "composite_scene"
      ]
    },
    "asset_name": {
      "type": "string"
    },
    "asset_description": {
      "type": [
        "string",
        "null"
      ]
    },
    "library_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "equipment_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_file_id": {
            "type": "string"
          },
          "file_uri": {
            "type": "string"
          },
          "asset_format": {
            "type": "string",
            "enum": [
              "solidworks_part",
              "solidworks_assembly",
              "fbx",
              "three_ds_max",
              "c4d",
              "step",
              "iges",
              "obj",
              "stl",
              "gltf",
              "glb",
              "unity_prefab",
              "thumbnail",
              "unknown"
            ]
          },
          "native_extension": {
            "type": "string"
          },
          "file_role": {
            "type": "string",
            "enum": [
              "source_model",
              "visual_model",
              "collision_model",
              "simplified_model",
              "thumbnail",
              "metadata_file",
              "runtime_mesh",
              "three_viewport_runtime_model"
            ]
          },
          "checksum": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_unit": {
            "type": "string",
            "enum": [
              "m",
              "mm",
              "cm",
              "inch",
              "unknown"
            ]
          },
          "file_status": {
            "type": "string",
            "enum": [
              "available",
              "missing",
              "corrupted",
              "deprecated",
              "pending_conversion"
            ]
          },
          "metadata": {
            "type": "object",
            "properties": {
              "author": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_system": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "created_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "updated_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "author",
              "source_system",
              "created_at",
              "updated_at"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "source_file_id",
          "file_uri",
          "asset_format",
          "native_extension",
          "file_role",
          "checksum",
          "source_unit",
          "file_status",
          "metadata"
        ]
      }
    },
    "derived_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "derived_file_id": {
            "type": "string"
          },
          "file_uri": {
            "type": "string"
          },
          "asset_format": {
            "type": "string",
            "enum": [
              "solidworks_part",
              "solidworks_assembly",
              "fbx",
              "three_ds_max",
              "c4d",
              "step",
              "iges",
              "obj",
              "stl",
              "gltf",
              "glb",
              "unity_prefab",
              "thumbnail",
              "unknown"
            ]
          },
          "file_role": {
            "type": "string",
            "enum": [
              "source_model",
              "visual_model",
              "collision_model",
              "simplified_model",
              "thumbnail",
              "metadata_file",
              "runtime_mesh",
              "three_viewport_runtime_model"
            ]
          },
          "derived_from_source_file_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "checksum": {
            "type": [
              "string",
              "null"
            ]
          },
          "file_status": {
            "type": "string",
            "enum": [
              "available",
              "missing",
              "corrupted",
              "deprecated",
              "pending_conversion"
            ]
          },
          "file_size_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "compression": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "file_uri",
          "asset_format",
          "file_role",
          "file_status"
        ]
      }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "extraction_status": {
          "type": "string",
          "enum": [
            "not_extracted",
            "extracted",
            "partially_extracted",
            "failed",
            "requires_manual_review"
          ]
        },
        "extractor_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "extractor_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "extraction_method": {
          "type": "string",
          "enum": [
            "cad_api",
            "mesh_parser",
            "scene_parser",
            "manual_input",
            "hybrid",
            "three_fbx_to_obj_runtime_export",
            "unknown"
          ]
        },
        "extracted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_format": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "solidworks_part",
            "solidworks_assembly",
            "fbx",
            "three_ds_max",
            "c4d",
            "step",
            "iges",
            "obj",
            "stl",
            "gltf",
            "glb",
            "unity_prefab",
            "thumbnail",
            "unknown",
            null
          ]
        },
        "source_unit": {
          "type": [
            "string",
            "null"
