          "enum": [
            "m",
            "mm",
            "cm",
            "inch",
            "unknown",
            null
          ]
        },
        "unit_scale_to_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "axis_mapping": {
          "type": "object",
          "properties": {
            "source_up_axis": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "x",
                "y",
                "z",
                "negative_x",
                "negative_y",
                "negative_z",
                "unknown",
                null
              ]
            },
            "target_up_axis": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "x",
                "y",
                "z",
                "negative_x",
                "negative_y",
                "negative_z",
                "unknown",
                null
              ]
            },
            "layout_x_from_source_axis": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "x",
                "y",
                "z",
                "negative_x",
                "negative_y",
                "negative_z",
                "unknown",
                null
              ]
            },
            "layout_y_from_source_axis": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "x",
                "y",
                "z",
                "negative_x",
                "negative_y",
                "negative_z",
                "unknown",
                null
              ]
            },
            "layout_z_from_source_axis": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "x",
                "y",
                "z",
                "negative_x",
                "negative_y",
                "negative_z",
                "unknown",
                null
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "source_up_axis",
            "target_up_axis",
            "layout_x_from_source_axis",
            "layout_y_from_source_axis",
            "layout_z_from_source_axis"
          ]
        },
        "extraction_quality": {
          "type": "object",
          "properties": {
            "geometry_confidence": {
              "type": [
                "number",
                "null"
              ]
            },
            "scale_confidence": {
              "type": [
                "number",
                "null"
              ]
            },
            "origin_confidence": {
              "type": [
                "number",
                "null"
              ]
            },
            "port_confidence": {
              "type": [
                "number",
                "null"
              ]
            },
            "site_feature_confidence": {
              "type": [
                "number",
                "null"
              ]
            },
            "requires_manual_review": {
              "type": "boolean"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "geometry_confidence",
            "scale_confidence",
            "origin_confidence",
            "port_confidence",
            "site_feature_confidence",
            "requires_manual_review",
            "warnings"
          ]
        },
        "raw_metadata": {
          "type": "object",
          "properties": {
            "solidworks": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "fbx": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "three_ds_max": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "c4d": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "other": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "solidworks",
            "fbx",
            "three_ds_max",
            "c4d",
            "other"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "extraction_status",
        "extractor_name",
        "extractor_version",
        "extraction_method",
        "extracted_at",
        "source_format",
        "source_unit",
        "unit_scale_to_m",
        "axis_mapping",
        "extraction_quality",
        "raw_metadata"
      ]
    },
    "coordinate_frames": {
      "type": "array",
      "items": {
        "$ref": "../common/common_engineering.schema.json#/$defs/CoordinateFrame"
      }
    },
    "geometry": {
      "$ref": "../common/common_engineering.schema.json#/$defs/Geometry"
    },
    "planning_fields": {
      "type": "object",
      "properties": {
        "allowed_orientations_deg": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "maintenance_clearance_m": {
          "$ref": "../common/common_engineering.schema.json#/$defs/ClearanceM"
        },
        "safety_clearance_m": {
          "$ref": "../common/common_engineering.schema.json#/$defs/ClearanceM"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "../common/common_engineering.schema.json#/$defs/Port"
          }
        },
        "compatible_upstream_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compatible_downstream_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_zone_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_zone_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "process_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "allowed_orientations_deg",
        "maintenance_clearance_m",
        "safety_clearance_m",
        "ports",
        "compatible_upstream_categories",
        "compatible_downstream_categories",
        "allowed_zone_types",
        "forbidden_zone_types",
        "process_capabilities"
      ]
    },
    "site_asset_fields": {
      "type": "object",
      "properties": {
        "boundary": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "shape_type": {
                  "type": "string",
                  "enum": [
                    "rectangle"
                  ]
                },
                "pose": {
                  "$ref": "../common/common_engineering.schema.json#/$defs/Pose"
                },
                "dimensions_m": {
                  "$ref": "../common/common_engineering.schema.json#/$defs/DimensionsM"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "model_extraction",
                    "manual_input",
                    "user_input",
                    "rule_library",
                    "computed",
                    "runtime_obj_bounds"
                  ]
                },
                "confidence": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "shape_type",
                "pose",
                "dimensions_m",
                "source",
                "confidence"
              ]
            },
