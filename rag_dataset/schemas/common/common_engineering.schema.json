          "type": "string"
        },
        "constraint_type": {
          "type": "string"
        },
        "target_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetRef"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "source": {
          "type": "string",
          "enum": [
            "user_input",
            "model_file",
            "model_extraction",
            "asset_library",
            "rule_library",
            "vocabulary",
            "llm_compiler",
            "manual_override",
            "computed"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "constraint_type",
        "target_refs",
        "parameters",
        "source",
        "evidence_refs"
