        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "source": {
          "type": "string",
          "enum": [
            "user_input",
            "model_file",
            "model_extraction",
            "asset_library",
            "rule_library",
            "vocabulary",
            "llm_compiler",
            "manual_override",
            "computed"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "objective_id",
        "objective_type",
        "sense",
        "weight",
        "parameters",
        "source",
        "evidence_refs"
      ]
