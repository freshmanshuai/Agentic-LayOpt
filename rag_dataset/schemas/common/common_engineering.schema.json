  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "unit_system": {
      "$ref": "#/$defs/UnitSystem"
    },
    "coordinate_frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CoordinateFrame"
      }
    },
    "pose": {
      "$ref": "#/$defs/Pose"
    },
    "geometry": {
      "$ref": "#/$defs/Geometry"
    },
    "clearance_m": {
      "$ref": "#/$defs/ClearanceM"
    },
    "port": {
      "$ref": "#/$defs/Port"
    },
    "target_ref": {
      "$ref": "#/$defs/TargetRef"
    },
    "source_ref": {
      "$ref": "#/$defs/SourceRef"
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProvenanceItem"
      }
    },
    "unresolved_item": {
      "$ref": "#/$defs/UnresolvedItem"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    }
  },
  "additionalProperties": false
}
